{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/safety-guard.js",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "session-init": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/session-init.js",
        "timeout": 10
      }
    ]
  },
  "quality-reminder": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/pre-invocation-reminder.js",
        "timeout": 10
      }
    ]
  }
}

